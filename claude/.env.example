# Copy to .env (gitignored). procure loads it automatically; real env vars win.

# DigiKey Product Information API v4: create a *production* app at
# https://developer.digikey.com (sandbox apps return dummy data).
DIGIKEY_CLIENT_ID=
DIGIKEY_CLIENT_SECRET=
# DIGIKEY_LOCALE_SITE=US
# DIGIKEY_LOCALE_CURRENCY=USD

# Mouser Search API key: https://www.mouser.com/api-search/
MOUSER_API_KEY=
# MOUSER_API_BASE=https://api.mouser.com/api/v1.0
